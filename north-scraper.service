[Unit]
Description=North India College Scraper Pipeline
After=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/northParrellelcollege
ExecStart=/home/ubuntu/northParrellelcollege/.venv/bin/python /home/ubuntu/northParrellelcollege/run_pipeline.py --final-output final_north_india_deep_contacts.xlsx
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target